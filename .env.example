# Base de datos local (docker compose up -d db)
DATABASE_URL=postgres://ayuda:ayuda_local@localhost:5439/ayuda

# --- Inferencia (opcional) ---
# Sin llave la app funciona igual: la caja de preguntas degrada a busqueda de
# texto plano. Nunca exponer al navegador.
AI_ENABLED=off
DO_GRADIENT_BASE_URL=https://inference.do-ai.run/v1
DO_GRADIENT_API_KEY=
# Para extraer intencion, openai-gpt-oss-20b alcanza y cuesta menos.
DO_GRADIENT_MODEL=openai-gpt-oss-20b

# Area de cobertura (codigo DANE de departamento). 76 = Valle del Cauca.
OPERATING_ADMIN1_CODE=76

# Secreto para disparar /api/ingest por cron. Sin esto la ruta responde 503.
INGEST_SECRET=

# Firma la cookie anonima y las llaves del limitador. Obligatorio en produccion.
RATE_LIMIT_SECRET=

# --- bin/kamal (deploy) ---
# IP o hostname Tailscale del servidor. Ver config/deploy.yml.
DEPLOY_HOST=

# --- Límites operativos (opcionales) ---
# Todos tienen un valor por defecto que funciona; descomentá solo el que
# necesites mover. En producción se cambian editando la línea equivalente en
# config/deploy.yml y corriendo `kamal env push` — reinicia el contenedor,
# no reconstruye la imagen.

# Cupo de INFERENCIA. Al agotarse, la búsqueda determinista sigue funcionando:
# se pierde la interpretación de la pregunta, nunca la capacidad de buscar.
# QUOTA_CLIENT_HOUR=10
# QUOTA_CLIENT_DAY=30
# QUOTA_NETWORK_HOUR=60
# QUOTA_GLOBAL_MINUTE=20

# Descarte de avalancha en el middleware, por red truncada (/24, /48).
# FLOOD_NETWORK_PER_MINUTE=120
# Por encima de este total por minuto, el sitio avisa que está con mucha carga.
# FLOOD_HIGH_LOAD_PER_MINUTE=600

# El feed de Mapa de Emergencia trae 613 puntos de tipo "rescate": sitios que
# NECESITAN ayuda, con conteo de voluntarios que faltan. Eso es el tipo `need`,
# fuera de v1, y entra solo si se enciende esto a proposito.
# MAPA_EMERGENCIA_INCLUIR_RESCATE=on
